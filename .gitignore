# ================================
# 🐍 Python Project .gitignore
# ================================

# ────────────────────────────────
# 🔒 가상환경 (Virtual Environment)
# ────────────────────────────────
venv/
env/
ENV/
.venv/
.virtualenv/
virtualenv/
pipenv/
pyenv/

# ────────────────────────────────
# 🗑️ Python 캐시 & 컴파일 파일
# ────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll
*.pyd

# ────────────────────────────────
# 🔐 환경 변수 & 비밀 키
# ────────────────────────────────
.env
.env.local
.env.*.local
*.env
secrets.json
config.ini

# ────────────────────────────────
# 💻 IDE & 에디터 설정
# ────────────────────────────────
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# Sublime Text
*.sublime-project
*.sublime-workspace

# ────────────────────────────────
# 📊 데이터베이스
# ────────────────────────────────
*.db
*.sqlite
*.sqlite3
db.json

# ────────────────────────────────
# 📝 로그 파일
# ────────────────────────────────
*.log
logs/
*.log.*

# ────────────────────────────────
# 🖥️ OS 관련 파일
# ────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
desktop.ini
ehthumbs.db

# Linux
*~

# ────────────────────────────────
# 📦 빌드 & 배포
# ────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/
*.whl

# ────────────────────────────────
# 📓 Jupyter Notebook
# ────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ────────────────────────────────
# 🧪 테스트 & 커버리지
# ────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ────────────────────────────────
# 📚 문서
# ────────────────────────────────
docs/_build/
site/

# ────────────────────────────────
# 🔧 기타
# ────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# 임시 파일
*.tmp
*.temp
*.bak
*.swp

# 압축 파일
*.zip
*.tar.gz
*.rar

# ────────────────────────────────
# 🎯 프로젝트별 커스텀
# ────────────────────────────────
# 여기에 프로젝트 특화 제외 파일 추가
